# Colores para notificaciones
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Variables
OUTPUT_BASE="$HOME/FAROSINT/output"
mkdir -p "$OUTPUT_BASE"

# Iconos y tema
ICON_PATH="/usr/share/icons/hicolor/48x48/apps"
WINDOW_ICON="security-high"

# ============================================================================
# FUNCIONES AUXILIARES MEJORADAS
# ============================================================================

show_notification() {
    local title="$1"
    local message="$2"
    notify-send -i "$WINDOW_ICON" "$title" "$message" 2>/dev/null || echo "$title: $message"
}

run_in_terminal() {
    local title="$1"
    local command="$2"

    x-terminal-emulator -T "$title" -e bash -c "
        echo -e '\033[0;36m'
        echo '═══════════════════════════════════════════════════════'
        echo '  $title'
        echo '═══════════════════════════════════════════════════════'
        echo -e '\033[0m'
        echo ''
        $command
        echo ''
        echo -e '\033[0;32m✓ Completado\033[0m'
        echo ''
        read -p 'Presiona ENTER para cerrar...' dummy
    " &
}

