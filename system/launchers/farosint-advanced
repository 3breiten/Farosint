        --title="Httpx - Verificación de URLs" \
        --window-icon="emblem-web" \
        --width=600 --center \
        --text="<b>Httpx</b> - Verificar URLs activas y obtener información\n\nDetecta: Status codes, títulos, tecnologías, redirects" \
        --field="Tipo de input:":CB "URL única!Archivo de subdominios" \
        --field="URL o archivo:" "" \
        --button="gtk-cancel:1" \
        --button="Escanear!gtk-execute:0")

    if [ $? -ne 0 ]; then
        return
    fi

    tipo=$(echo "$result" | cut -d'|' -f1)
    input=$(echo "$result" | cut -d'|' -f2)

    if [ -z "$input" ]; then
        return
    fi

    OUTPUT_DIR="$OUTPUT_BASE/$(date +%Y%m%d_%H%M%S)_httpx"
